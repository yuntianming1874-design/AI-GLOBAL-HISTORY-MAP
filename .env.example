# ── Database (optional) ─────────────────────────────────────────────
# When set, the app uses PostgreSQL (run `npm run seed:db` first).
# Without it, the app runs on the built-in in-memory seed data.
DATABASE_URL=

# ── Mapbox GL (optional) ─────────────────────────────────────────────
# When set, the interactive map uses Mapbox GL. Without it, a full
# D3 world map renders the same data automatically.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── AI assistant (optional) ──────────────────────────────────────────
# When set, /api/chat uses the OpenAI-compatible API. Without it, a
# local retrieval assistant answers from the seed knowledge base.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
