{
  "name": "ai-global-history-map",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive world history visualization: Tang Dynasty era timeline, map, person graph and AI assistant",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:seed": "tsx scripts/validate-seed.ts",
    "seed:db": "tsx scripts/seed-db.ts",
    "fetch:territories": "tsx scripts/fetch-territories.ts",
    "test:e2e": "playwright test",
    "audit:history": "tsx scripts/audit-history-data.ts",
    "test:interaction": "esbuild scripts/timeline-interaction.test.tsx --bundle --platform=node --format=cjs --jsx=automatic --packages=external --outfile=.tmp-tl-test.cjs && node scripts/tl-harness.cjs && rm -f .tmp-tl-test.cjs",
    "test:provenance": "tsx scripts/provenance.test.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "mapbox-gl": "^3.6.0",
    "next": "^14.2.15",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^14.3.1",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
